# ── Server ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── PostgreSQL ────────────────────────────────────────────
DATABASE_URL=postgresql://tiffin:tiffin_pass@localhost:5432/tiffin_db

# ── Redis (used by BullMQ + ioredis) ─────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Elasticsearch ─────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ── Google OAuth ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ── Slack OAuth ───────────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/slack/oauth/callback

# ── Nodemailer / Ethereal (fake SMTP for dev) ────────────
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── BullMQ Limits (never hardcoded) ──────────────────────
QUEUE_CONCURRENCY=5
QUEUE_RATE_LIMIT_MAX=100
QUEUE_RATE_LIMIT_DURATION=3600000
QUEUE_RETRY_ATTEMPTS=3
QUEUE_RETRY_DELAY=5000

# ── Frontend URL (for CORS) ──────────────────────────────
FRONTEND_URL=http://localhost:3000
